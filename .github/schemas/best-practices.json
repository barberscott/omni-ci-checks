{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Omni best-practices review findings",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings"],
  "properties": {
    "summary": {
      "type": "string",
      "description": "One-sentence overall assessment of the diff."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "severity", "rule", "message"],
        "properties": {
          "file": {
            "type": "string",
            "description": "Path of the file relative to repo root."
          },
          "line": {
            "type": "integer",
            "description": "1-indexed line number; omit if not file-local."
          },
          "severity": {
            "enum": ["error", "warning", "info"]
          },
          "rule": {
            "type": "string",
            "description": "Short rule identifier (kebab-case)."
          },
          "message": {
            "type": "string",
            "description": "Concise description of the issue."
          },
          "suggestion": {
            "type": "string",
            "description": "Optional concrete fix suggestion."
          }
        }
      }
    }
  }
}
